# SmartStudy AI - Backend Environment Configuration
# Add your Google Gemini API key obtained from Google AI Studio / Google Cloud:
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Model selection (configurable, defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=5000
HOST=127.0.0.1
FLASK_ENV=development
